<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" loaded="loaded">
    <ActionBar title="Conversate">
        <NavigationButton text="Back" tap="{{ onBackTap }}" />
    </ActionBar>
    <ScrollView>
        <StackLayout class="screen-content phone-content">
            <Label text="Privacy &amp; processing" class="section-label" />
            <Label text="{{ disclosure }}" textWrap="true" class="supporting-text m-t-4" />
            <Button text="Transcription provider: {{ provider }}" tap="{{ onProviderTap }}" class="-primary m-t-8" />
            <Label text="On-device is the default. A configured cloud provider is used only after you explicitly select it; Hermes never silently sends the same audio to another provider."
                   textWrap="true" class="supporting-text m-t-8" />
            <Label text="Conversation text remains in memory only and clears when the window closes. Conversate never retains raw audio. Translation never hides source text when it is late or unavailable."
                   textWrap="true" class="supporting-text m-t-8" />

            <Label text="Languages" class="section-label m-t-20" />
            <Button text="Source: {{ sourceLanguage }}" tap="{{ onSourceTap }}" class="-secondary m-t-8" />
            <Button text="Translate to: {{ targetLanguage }}" tap="{{ onTargetTap }}" class="-secondary m-t-8" />
            <Button text="Layout: {{ layout }}" tap="{{ onLayoutTap }}" class="-secondary m-t-8" />

            <Label text="Readability" class="section-label m-t-20" />
            <Button text="Font: {{ fontSize }}" tap="{{ onFontTap }}" class="-secondary m-t-8" />
            <Button text="Line spacing: {{ lineSpacing }}" tap="{{ onSpacingTap }}" class="-secondary m-t-8" />
            <Button text="Maximum lines: {{ maxLines }}" tap="{{ onMaxLinesTap }}" class="-secondary m-t-8" />

            <Label text="Provider evidence" class="section-label m-t-20" />
            <GridLayout columns="*,auto" class="control-row">
                <Label col="0" text="Speaker labels" class="control-row-label" verticalAlignment="center" />
                <Switch col="1" checked="{{ speakerLabels }}" isEnabled="{{ speakerLabelsAvailable }}" accessibilityLabel="Speaker labels" />
            </GridLayout>
            <Label text="Speaker labels appear only when the provider supplies a documented speaker identifier; Hermes never guesses."
                   textWrap="true" class="supporting-text m-t-4" />

            <Label text="Custom vocabulary" class="section-label m-t-20" />
            <TextField text="{{ vocabulary }}" textChange="{{ onVocabularyTextChange }}"
                       hint="Comma-separated words" autocorrect="false" autocapitalizationType="none"
                       accessibilityLabel="Custom caption vocabulary" />
            <Button text="Save bounded vocabulary" tap="{{ onSaveVocabularyTap }}" class="-primary m-t-8" />
            <Label text="{{ vocabularyStatus }}" textWrap="true" class="supporting-text m-t-4" />
        </StackLayout>
    </ScrollView>
</Page>
