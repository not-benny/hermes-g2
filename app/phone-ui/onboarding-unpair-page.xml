<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" actionBarHidden="true">
    <GridLayout rows="*,auto" class="p-20">
        <ScrollView row="0">
            <StackLayout verticalAlignment="center" class="p-8">
                <StackLayout class="onb-card">
                    <Label text="🔌" class="onb-icon text-center" />
                    <Label text="Disconnect the Even app" class="h2 text-center m-t-8" textWrap="true" />
                    <Label text="Hermes and the official Even Realities app can't both hold the glasses connection at once. In the Even app:"
                           class="onb-body m-t-16" textWrap="true" />
                    <Label text="1.  Open Home and select your glasses.&#10;2.  Open the Connection submenu.&#10;3.  Press Disconnect (or turn off the Even app's Bluetooth)."
                           class="onb-body m-t-8" textWrap="true" />
                    <Label text="Then come back here and continue." class="onb-body m-t-8" textWrap="true" />
                    <Button text="Open Even app settings" tap="{{ onOpenEvenAppSettingsTap }}" class="m-t-16" />
                </StackLayout>
            </StackLayout>
        </ScrollView>

        <GridLayout row="1" columns="*,*" class="m-t-20">
            <Button col="0" text="Back" tap="{{ onBackTap }}" />
            <Button col="1" text="Continue" tap="{{ onContinueTap }}" class="-primary" />
        </GridLayout>
    </GridLayout>
</Page>
