<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" loaded="loaded" unloaded="unloaded">
    <ActionBar title="Hermes" />
    <ScrollView>
        <StackLayout class="phone-content hermes-companion-content p-20">
            <GridLayout columns="auto,*" class="hermes-status-strip" accessibilityLiveRegion="polite">
                <Label col="0" text="●" class="{{ statusDotClass }}" verticalAlignment="center" accessibilityHidden="true" />
                <StackLayout col="1" class="m-l-8">
                    <Label text="{{ statusLabel }}" class="value" textWrap="true" />
                    <Label text="{{ statusDetail }}" class="muted" textWrap="true" />
                </StackLayout>
            </GridLayout>

            <StackLayout class="status-banner status-warning m-t-12" visibility="{{ offlineVisibility }}"
                         accessibilityRole="alert" accessibilityLiveRegion="assertive">
                <Label text="Connection not ready" class="section-label" />
                <Label text="Voice and Cockpit actions remain disabled until a fresh authoritative session snapshot arrives. Nothing is queued."
                       class="supporting-text m-t-4" textWrap="true" />
                <Button text="Open bridge settings" tap="{{ onOpenBridgeSettingsTap }}" class="-secondary m-t-8" />
            </StackLayout>

            <GridLayout rows="auto,auto" columns="*,*" class="surface-card m-t-12 hermes-summary-grid"
                        visibility="{{ compactVisibility }}">
                <StackLayout row="0" col="0" class="hermes-metric-cell">
                    <Label text="BRIDGE" class="section-label" />
                    <Label text="{{ connectionLabel }}" textWrap="true" />
                </StackLayout>
                <StackLayout row="0" col="1" class="hermes-metric-cell">
                    <Label text="HOST MCP" class="section-label" />
                    <Label text="{{ cockpitLabel }}" textWrap="true" />
                </StackLayout>
                <StackLayout row="1" col="0" class="hermes-metric-cell">
                    <Label text="RUNS" class="section-label" />
                    <Label text="{{ activeLabel }}" />
                </StackLayout>
                <StackLayout row="1" col="1" class="hermes-metric-cell">
                    <Label text="ATTENTION" class="section-label" />
                    <Label text="{{ attentionLabel }}" textWrap="true" />
                </StackLayout>
            </GridLayout>
            <GridLayout columns="*,*,*,*" class="surface-card m-t-12 hermes-summary-grid"
                        visibility="{{ wideVisibility }}">
                <StackLayout col="0" class="hermes-metric-cell"><Label text="BRIDGE" class="section-label" /><Label text="{{ connectionLabel }}" textWrap="true" /></StackLayout>
                <StackLayout col="1" class="hermes-metric-cell"><Label text="HOST MCP" class="section-label" /><Label text="{{ cockpitLabel }}" textWrap="true" /></StackLayout>
                <StackLayout col="2" class="hermes-metric-cell"><Label text="RUNS" class="section-label" /><Label text="{{ activeLabel }}" /></StackLayout>
                <StackLayout col="3" class="hermes-metric-cell"><Label text="ATTENTION" class="section-label" /><Label text="{{ attentionLabel }}" textWrap="true" /></StackLayout>
            </GridLayout>

            <StackLayout class="surface-card m-t-12">
                <Label text="SHARED HERMES RUNS" class="section-label" />
                <Label text="No current or recent Hermes runs are shared with the G2."
                       class="supporting-text m-t-8" textWrap="true" visibility="{{ sessionsEmptyVisibility }}" />
                <Repeater items="{{ sessions }}" visibility="{{ sessionsVisibility }}">
                    <Repeater.itemTemplate>
                        <StackLayout class="hermes-session-row">
                            <GridLayout columns="*,auto">
                                <Label col="0" text="{{ title }}" class="list-row-title" textWrap="true" verticalAlignment="center" />
                                <Label col="1" text="{{ stateLabel }}" class="{{ stateClass }}" verticalAlignment="center" />
                            </GridLayout>
                            <Label text="{{ summary }}" class="supporting-text m-t-4" textWrap="true"
                                   visibility="{{ summaryVisibility }}" />
                            <Label text="{{ detail }}" class="supporting-text m-t-4" />
                            <Label text="{{ attentionLabel }}" class="hermes-attention-label m-t-4" textWrap="true"
                                   visibility="{{ attentionVisibility }}" />
                        </StackLayout>
                    </Repeater.itemTemplate>
                </Repeater>
                <Label text="{{ lastReceiptLabel }}" class="supporting-text m-t-8" textWrap="true"
                       accessibilityLiveRegion="polite" visibility="{{ lastReceiptVisibility }}" />
            </StackLayout>

            <StackLayout class="surface-card m-t-12">
                <Label text="ON THE GLASSES" class="section-label" />
                <Label text="Start a voice request with the configured assistant gesture. Open Hermes Cockpit on the lenses to review shared runs, answer questions, approve once, steer, or interrupt."
                       class="supporting-text m-t-8" textWrap="true" />
                <Label text="This phone page is a read-only view of the same validated projection."
                       class="supporting-text m-t-4" textWrap="true" />
            </StackLayout>
        </StackLayout>
    </ScrollView>
</Page>
