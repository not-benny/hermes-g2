<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" loaded="loaded">
    <ActionBar title="Even Health — EXPERIMENTAL" />
    <ScrollView>
        <StackLayout class="p-20">
            <Label text="⚠ EXPERIMENTAL — barely working. This cloud path is reconstructed from the Even app, has NOT been validated against the real API, and almost certainly does not work yet: the server needs a full device-identity + signature handshake that is only partially reproduced. Expect a &quot;device went wrong&quot; error. Nothing here is tested." textWrap="true" class="m-t-4" />
            <Label text="{{ status }}" textWrap="true" class="m-t-12" />
            <Label text="Intended to fetch ring health the official Even app syncs to Even's cloud. Secrets stay hidden; leave a field blank to keep its saved value." textWrap="true" class="m-t-8" />

            <Label text="Even account" class="h2 m-t-20" />
            <Label text="Email or phone" class="m-t-8" />
            <TextField text="{{ email }}" textChange="{{ onEmailTextChange }}" autocorrect="false" autocapitalizationType="none" keyboardType="email" />
            <Label text="{{ passwordConfigured }}" class="m-t-8" />
            <TextField hint="Even password — leave blank to keep" textChange="{{ onPasswordTextChange }}" secure="true" autocorrect="false" autocapitalizationType="none" />

            <Label text="API signing (from the official app)" class="h2 m-t-20" />
            <Label text="{{ appIdConfigured }}" class="m-t-8" />
            <TextField hint="app_id — leave blank to keep" textChange="{{ onAppIdTextChange }}" secure="true" autocorrect="false" autocapitalizationType="none" />
            <Label text="{{ accessKeyConfigured }}" class="m-t-8" />
            <TextField hint="accessKey — leave blank to keep" textChange="{{ onAccessKeyTextChange }}" secure="true" autocorrect="false" autocapitalizationType="none" />
            <Label text="{{ accessSecretConfigured }}" class="m-t-8" />
            <TextField hint="accessKeySecret — leave blank to keep" textChange="{{ onAccessSecretTextChange }}" secure="true" autocorrect="false" autocapitalizationType="none" />
            <Label text="{{ aesKeyConfigured }}" class="m-t-8" />
            <TextField hint="password AES key — leave blank to keep" textChange="{{ onAesKeyTextChange }}" secure="true" autocorrect="false" autocapitalizationType="none" />
            <Label text="{{ aesIvConfigured }}" class="m-t-8" />
            <TextField hint="password AES IV — leave blank to keep" textChange="{{ onAesIvTextChange }}" secure="true" autocorrect="false" autocapitalizationType="none" />

            <Button text="Save" tap="{{ onSaveTap }}" class="-primary m-t-24" />

            <Label text="{{ signInState }}" class="h2 m-t-20" />
            <GridLayout columns="*,*" class="m-t-8">
                <Button col="0" text="Sign in" tap="{{ onSignInTap }}" class="-primary" />
                <Button col="1" text="Sign out" tap="{{ onSignOutTap }}" />
            </GridLayout>
            <Button text="Fetch latest health" tap="{{ onFetchHealthTap }}" class="m-t-8" />
            <Label text="{{ health }}" textWrap="true" class="m-t-12" />

            <Button text="Back" tap="{{ onBackTap }}" class="m-t-24" />
        </StackLayout>
    </ScrollView>
</Page>
