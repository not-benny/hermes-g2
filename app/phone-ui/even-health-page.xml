<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" unloaded="unloaded">
    <ActionBar title="Even Health" />
    <ScrollView>
        <StackLayout class="p-20">
            <Label text="{{ ringStatusLabel }}" textWrap="true" class="muted" />
            <Label text="{{ lastUpdatedLabel }}" textWrap="true" class="muted m-t-4" />
            <Label text="Waiting for the R1 ring to sync. Connect the glasses session and wear the ring; live values appear here."
                   textWrap="true" class="muted m-t-16" visibility="{{ emptyStateVisibility }}" />

            <GridLayout rows="auto,auto,auto" columns="*,*" class="m-t-12">
                <StackLayout row="0" col="0" class="card tile">
                    <Label text="Heart rate" class="tile-metric" />
                    <StackLayout orientation="horizontal" class="m-t-4">
                        <Label text="{{ heartRateValue }}" class="tile-value" />
                        <Label text="{{ heartRateUnit }}" class="tile-unit" />
                    </StackLayout>
                    <Label text="{{ heartRateSub }}" class="tile-trend" textWrap="true" />
                </StackLayout>

                <StackLayout row="0" col="1" class="card tile">
                    <Label text="SpO₂" class="tile-metric" />
                    <StackLayout orientation="horizontal" class="m-t-4">
                        <Label text="{{ spo2Value }}" class="tile-value" />
                        <Label text="{{ spo2Unit }}" class="tile-unit" />
                    </StackLayout>
                    <Label text="{{ spo2Sub }}" class="tile-trend" textWrap="true" />
                </StackLayout>

                <StackLayout row="1" col="0" class="card tile">
                    <Label text="HRV" class="tile-metric" />
                    <StackLayout orientation="horizontal" class="m-t-4">
                        <Label text="{{ hrvValue }}" class="tile-value" />
                        <Label text="{{ hrvUnit }}" class="tile-unit" />
                    </StackLayout>
                    <Label text="{{ hrvSub }}" class="tile-trend" textWrap="true" />
                </StackLayout>

                <StackLayout row="1" col="1" class="card tile">
                    <Label text="Temperature" class="tile-metric" />
                    <StackLayout orientation="horizontal" class="m-t-4">
                        <Label text="{{ temperatureValue }}" class="tile-value" />
                        <Label text="{{ temperatureUnit }}" class="tile-unit" />
                    </StackLayout>
                    <Label text="{{ temperatureSub }}" class="tile-trend" textWrap="true" />
                </StackLayout>

                <StackLayout row="2" col="0" class="card tile tile-locked">
                    <Label text="Sleep" class="tile-metric" />
                    <Label text="🔒" class="tile-value" />
                    <Label text="{{ sleepHint }}" class="tile-trend" textWrap="true" />
                </StackLayout>

                <StackLayout row="2" col="1" class="card tile">
                    <Label text="Battery" class="tile-metric" />
                    <StackLayout orientation="horizontal" class="m-t-4">
                        <Label text="{{ batteryValue }}" class="tile-value" />
                        <Label text="{{ batteryUnit }}" class="tile-unit" />
                    </StackLayout>
                    <Label text="{{ batterySub }}" class="tile-trend" textWrap="true" />
                </StackLayout>
            </GridLayout>
        </StackLayout>
    </ScrollView>
</Page>
