<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" unloaded="unloaded">
    <ActionBar title="Settings" />
    <ScrollView>
        <StackLayout class="screen-content">
            <StackLayout visibility="{{ previewModeVisibility }}" class="status-banner status-info">
                <Label text="Preview mode" class="section-label" />
                <Label text="You are exploring Hermes with anonymous demo data and no glasses connected. Exit preview to set up your real glasses; all demo data is deleted."
                       class="supporting-text m-t-4" textWrap="true" />
                <Button text="Exit preview mode" tap="{{ onExitPreviewTap }}" class="-secondary m-t-8" />
            </StackLayout>

            <Label text="Devices" class="section-label m-t-20" />
            <StackLayout class="surface-card m-t-8">
                <Label text="Glasses and ring" class="section-heading" />
                <Label text="Review saved device addresses and discover nearby hardware without changing ownership."
                       class="supporting-text m-t-4" textWrap="true" />
                <Button text="Configure devices" tap="{{ onDevicesTap }}" class="-secondary m-t-12" />
            </StackLayout>

            <Label text="Health" class="section-label m-t-20" />
            <StackLayout class="surface-card m-t-8">
                <Label text="Personal estimates" class="section-heading" />
                <Label text="Set the local profile values used for calorie estimates."
                       class="supporting-text m-t-4" textWrap="true" />
                <Button text="Open health profile" tap="{{ onHealthProfileTap }}" class="-secondary m-t-12" />
            </StackLayout>

            <Label text="Credentials" class="section-label m-t-20" />
            <StackLayout class="surface-card m-t-8">
                <Label text="Hermes and providers" class="section-heading" />
                <Label text="Secrets stay masked and can only be replaced or explicitly cleared."
                       class="supporting-text m-t-4" textWrap="true" />
                <Button text="API keys &amp; bridge" tap="{{ onApiKeysTap }}" class="-secondary m-t-12" />
                <Label text="WhatsApp pairing is disabled: the embedded runtime is not validated for 16 KiB Android devices."
                       textWrap="true" class="supporting-text m-t-8" />
            </StackLayout>

            <Label text="Appearance" class="section-label m-t-20" />
            <StackLayout class="control-row">
                <Label text="Glasses font" class="control-row-label m-b-4" />
                <Label text="Choose the typeface used on the G2 display."
                       class="control-row-sublabel m-b-8" textWrap="true" />
                <SegmentedBar items="{{ uiFontItems }}" selectedIndex="{{ uiFontIndex }}" />
            </StackLayout>
        </StackLayout>
    </ScrollView>
</Page>
