<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" actionBarHidden="true">
    <GridLayout rows="*,auto" class="p-20">
        <ScrollView row="0">
            <StackLayout verticalAlignment="center" class="p-8">
                <StackLayout class="onb-card">
                    <Label text="⚡" class="onb-icon text-center" />
                    <Label text="{{ headline }}" class="h2 text-center m-t-8" textWrap="true" />
                    <ActivityIndicator busy="{{ busy }}" visibility="{{ busyVisibility }}" class="m-t-16" />
                    <Progress value="{{ progress }}" maxValue="100" visibility="{{ progressVisibility }}" class="m-t-16" />
                    <Label text="{{ status }}" class="onb-body text-center m-t-16" textWrap="true" />
                    <Label text="{{ log }}" class="muted m-t-16" textWrap="true" fontSize="12" visibility="{{ logVisibility }}" />
                </StackLayout>
            </StackLayout>
        </ScrollView>

        <GridLayout row="1" columns="*,*" class="m-t-20">
            <Button col="0" text="{{ secondaryLabel }}" tap="{{ onSecondaryTap }}" visibility="{{ secondaryVisibility }}" />
            <Button col="1" text="{{ primaryLabel }}" tap="{{ onPrimaryTap }}" visibility="{{ primaryVisibility }}" class="-primary" />
        </GridLayout>
    </GridLayout>
</Page>
