{
  "name": "hermes-g2",
  "description": "Hermes Agent interface for Even Realities G2 smart glasses",
  "main": "app/app.ts",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npx --no-install ns build android",
    "verify:release-unsigned": "npx --no-install ns prepare android && cd platforms/android && ./gradlew clean && ./gradlew assembleRelease -Prelease -PhermesUnsignedReleaseVerification=true",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nativescript/core": "~9.0.20",
    "@nativescript/theme": "^3.1.0",
    "@xterm/headless": "^6.0.0",
    "hermes-private-ws": "npm:ws@8.21.3",
    "lodash": "^4.18.1",
    "lz4js": "^0.2.0",
    "pako": "^2.1.0",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@nativescript/android": "9.0.5",
    "@nativescript/types": "~9.0.0",
    "@nativescript/webpack": "~5.0.25",
    "nativescript": "9.0.7",
    "typescript": "~5.4.0"
  },
  "overrides": {
    "axios": "1.19.0",
    "fork-ts-checker-webpack-plugin": {
      "minimatch": "3.1.5"
    },
    "lodash": "$lodash",
    "replace": {
      "minimatch": "3.1.5"
    },
    "serialize-javascript": "7.1.0",
    "simple-git": "3.36.0",
    "tar": "7.5.22",
    "ws": "8.21.3"
  }
}
